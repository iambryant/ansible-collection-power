version: 1
config:
    - type: physical
      name: eth0
      mac_address: '{{ lpar_mac_address_colon }}'
      subnets:
      - type: static
        address: '{{ lpar_instance.vm_ip }}'
        netmask: '{{ lpar_instance.subnetmask }}'
        gateway: '{{ lpar_instance.gateway }}'
    - type: nameserver
      address:
{% for nameserver in lpar_instance.nameservers %}
        - '{{ nameserver }}'
{% endfor %}
      search:
      - '{{ lpar_instance.domain }}'
