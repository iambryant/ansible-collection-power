set timeout=1

insmod regexp
regexp --set=1:m1 --set=2:m2 --set=3:m3 --set=4:m4 --set=5:m5 --set=6:m6 '^([0-9a-f]{1,2}):([0-9a-f]{1,2}):([0-9a-f]{1,2}):([0-9a-f]{1,2}):([0-9a-f]{1,2}):([0-9a-f]{1,2})' "$net_default_mac"
set mac=${m1}-${m2}-${m3}-${m4}-${m5}-${m6}

menuentry 'Install OS' {
    insmod tftp
    set root=(tftp,{{ lpar_netboot_server_ip }})
    echo 'Loading OS Install kernel ...'

    # Passing BOOTIF=01-${mac} forces Dracut to bypass probing dead links
    linux /ppc/ppc64/vmlinuz inst.stage2=http://{{ lpar_netboot_server_ip }}/{{ lpar_live_os_version }} inst.ks=http://{{ lpar_netboot_server_ip }}/kickstarts/{{ lpar_instance.hostname}}.ks ip=bootif BOOTIF=01-${mac}
    initrd /ppc/ppc64/initrd.img
}
